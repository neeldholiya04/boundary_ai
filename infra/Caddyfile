# Reverse proxy for the deployment (infra/docker-compose.deploy.yml). Caddy gets and renews the HTTPS
# certificate itself (Let's Encrypt); with an sslip.io name no domain is needed.
#
#   PUBLIC_HOST  the one hostname: sign-in page, the chat for user accounts, the dashboard
#                (guardrails, approvals, logs, tools, playground) for admin accounts
#
# Access is enforced by the agent (apps/agent/src/boundary_agent/auth.py): every /api path needs a
# signed-in account with the right role, so the proxy has no password of its own any more (it used to
# put basic auth on a second, admin-only host and serve only a public playground on this one).
# /metrics is never served through the proxy: Prometheus scrapes the agent on the internal network.

{
	# "email you@example.org" when ACME_EMAIL is set in .env, otherwise nothing (no contact address).
	{$ACME_EMAIL_DIRECTIVE}
}

(hardening) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$PUBLIC_HOST} {
	import hardening

	@metrics path /metrics
	handle @metrics {
		respond 404
	}

	@api path /api/* /health
	handle @api {
		reverse_proxy agent:8000 {
			flush_interval -1 # live updates (server-sent events) stream straight through
		}
	}

	handle {
		reverse_proxy dashboard:3000
	}
}
