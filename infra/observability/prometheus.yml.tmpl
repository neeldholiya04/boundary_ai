# Local Prometheus: scrapes the agent's /metrics on the host machine. AGENT_PORT (root .env,
# default 8000) is filled in when the container starts.
# Start with: docker compose --env-file .env -f infra/docker-compose.yml --profile observability up -d
global:
  scrape_interval: 5s
  evaluation_interval: 15s

scrape_configs:
  - job_name: boundary-agent
    metrics_path: /metrics
    static_configs:
      - targets: ["host.docker.internal:AGENT_PORT"]
        labels:
          service: boundary-agent
