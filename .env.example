# The one settings file for boundary-ai. Copy to .env (repo root) and fill in what you need.
# Read by the agent (`uv run boundary ...`), the dashboard (NEXT_PUBLIC_* only), and Docker Compose
# for deployment (`docker compose --env-file .env -f infra/docker-compose.deploy.yml ...`).
# Real environment variables always win over this file.

# --- App ---------------------------------------------------------------------
APP_NAME=boundary-ai
APP_ENV=development
# Where the dashboard is served from (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# --- Database and Redis ------------------------------------------------------
# Local containers: docker compose --env-file .env -f infra/docker-compose.yml up -d
# The same POSTGRES_* values are used by the deployment stack.
POSTGRES_DB=boundary
POSTGRES_USER=boundary
# Change this (and the password in DATABASE_URL to match).
POSTGRES_PASSWORD=boundary
# Host port for local Postgres; 5433 so it doesn't clash with a system Postgres on 5432.
POSTGRES_PORT=5433
REDIS_PORT=6379
# For a zero-setup run use DATABASE_URL=sqlite+aiosqlite:///./boundary.db and leave REDIS_URL empty.
DATABASE_URL=postgresql+asyncpg://boundary:boundary@localhost:5433/boundary
REDIS_URL=redis://localhost:6379/0

# --- Dashboard ---------------------------------------------------------------
# Where the browser sends API calls. `uv run boundary dev|web` sets this for you.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- LLM (via LiteLLM) -------------------------------------------------------
# Switch provider by changing LLM_MODEL and setting that provider's key.
#   openai/gpt-4.1-mini                  -> OPENAI_API_KEY
#   anthropic/claude-haiku-4-5-20251001  -> ANTHROPIC_API_KEY
#   gemini/<model>                       -> GEMINI_API_KEY
#   ollama/<model>                       -> no key; set LLM_API_BASE=http://localhost:11434
LLM_PROVIDER=litellm
LLM_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: override key/base URL for any OpenAI-compatible gateway.
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_NUM_RETRIES=2
ALLOW_DEMO_MOCK_PLANNER=false

# --- Guard -------------------------------------------------------------------
# Relative to the repository root. Leave empty to run without the guard.
GUARD_POLICY_PATH=policies/guard.yaml
# Blocked tool output: continue (withheld stub, run goes on) or halt (run ends).
GUARD_TOOL_OUTPUT_ON_BLOCK=continue
# Mark tool output as untrusted data in the planner prompt (nonce-delimited).
GUARD_SPOTLIGHT=true
# Labels whose detection in tool output taints the run (JSON list).
GUARD_TAINT_LABELS=["injection"]
# Add default "tainted run -> approve write/delete" rules on startup if none exist.
SEED_GUARD_SIGNAL_POLICIES=true
# Read token for the gated Llama Prompt Guard 2 model (or run `uv run hf auth login` once).
HF_TOKEN=

# --- Agent / MCP -------------------------------------------------------------
MAX_TOOL_STEPS=6
EXA_MCP_ENABLED=true
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_API_KEY=
REMOTE_MCP_URL=
REMOTE_MCP_TRANSPORT=sse
REMOTE_MCP_NAME=context7
APPROVAL_TTL_SECONDS=600
APPROVAL_SWEEPER_INTERVAL_SECONDS=5

# --- Observability -----------------------------------------------------------
# Tracing: a Langfuse project's keys (cloud.langfuse.com, or a self-hosted URL). Off when empty.
# Traces only hold guarded (redacted) text, never raw user input or raw tool output.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Local Prometheus + Grafana (docker compose ... --profile observability up -d).
# Port the agent API listens on, so Prometheus knows where to scrape.
AGENT_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=boundary-local

# --- Public playground and abuse controls --------------------------------------
# Hard cap on real LLM spend per UTC day across the app; 0 = no cap. Cassette replays are free.
LLM_DAILY_BUDGET_USD=0
PLAYGROUND_ENABLED=true
# Live runs = a pasted page through the real model (counts against the budget above).
PLAYGROUND_LIVE_RUNS=true
PLAYGROUND_MAX_INPUT_CHARS=8000
PLAYGROUND_SCANS_PER_MINUTE=30
PLAYGROUND_ATTACKS_PER_HOUR=10

# --- Deployment only (infra/docker-compose.deploy.yml; step by step in docs/DEPLOY.md) ---------
# The hostname on the server's public IP that serves the app (sign in, then chat or dashboard by
# role). An sslip.io name needs no domain, e.g. for IP 3.91.20.7:
#   PUBLIC_HOST=boundary.3-91-20-7.sslip.io
PUBLIC_HOST=

# --- Sign-in (all environments) ---------------------------------------------------------------
# Accounts as name:password:role (role: user = the chat, admin = the dashboard), comma-separated.
# Unset locally: admin/admin123 and user/user123. Deployments must set their own.
AUTH_USERS=
# Key that signs session tokens; unset locally means a random one per start (logins end on restart).
#   openssl rand -hex 32
AUTH_SECRET=
# Optional: email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Compose builds the agent's DATABASE_URL from POSTGRES_* above, so the local one is ignored there.
# On the server, set LLM_DAILY_BUDGET_USD above to a small number (the deploy stack defaults to 2).
